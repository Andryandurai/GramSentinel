# GramSentinel — copy to .env and fill in. Never commit the real .env.
#
# Everything below has a safe local-development default baked into
# backend/config/settings.py, so a fresh checkout works with an empty or
# missing .env. Set values here (locally) or as Render environment variables
# (in production) only for what you need to change.

# --- Core Django -------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
TIME_ZONE=Asia/Kolkata

# --- Database ------------------------------------------------------------
# Leave unset for local SQLite (backend/db.sqlite3, zero setup). Set to a
# postgres:// URL (Render's PostgreSQL add-on provides one automatically once
# attached to the backend web service) to use PostgreSQL instead. sqlite://
# URLs are intentionally NOT honoured here — see the comment in
# backend/config/settings.py for why.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=False

# --- Cross-origin / CSRF (frontend and backend are separate origins in
# production — a Render Static Site and a Render Web Service) --------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed for cookie/session requests — i.e. the Django admin login at
# /admin/, not the JWT-bearer API the React app uses. The backend's own
# Render URL is trusted automatically via RENDER_EXTERNAL_HOSTNAME (Render
# sets that for you); set this only for a custom domain.
CSRF_TRUSTED_ORIGINS=

# --- Production security (all gated on DEBUG=False; safe to leave unset
# locally) ------------------------------------------------------------------
# Starts conservative (1 hour) so a misconfiguration is never more than an
# hour of pain. Raise once HTTPS is confirmed working end to end.
SECURE_HSTS_SECONDS=3600

# --- LLM is OPTIONAL. Leave LLM_API_KEY empty and the platform runs
# entirely on deterministic logic — the safety engine, the agents and every
# portal work unchanged. The LLM only ever rewrites already-decided
# narrative text. --------------------------------------------------------
LLM_ENABLED=False
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=12

GRAMSENTINEL_LOG_LEVEL=INFO

# --- Frontend (set in frontend/.env locally, or as a Render Static Site
# build-time environment variable in production — see RENDER_DEPLOYMENT.md).
# This is a VITE_* variable: it is baked into the browser bundle at build
# time and is public. Never put a secret in a VITE_* variable. -------------
VITE_API_BASE_URL=http://localhost:8000/api
