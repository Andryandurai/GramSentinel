# GramSentinel — copy to .env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Kolkata

# SQLite is used for the prototype; PostgreSQL is future scope.
DATABASE_URL=sqlite:///backend/db.sqlite3

# LLM is OPTIONAL. Leave LLM_API_KEY empty and the platform runs entirely on
# deterministic logic — the safety engine, the agents and every portal work
# unchanged. The LLM only ever rewrites already-decided narrative text.
LLM_ENABLED=False
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=12

GRAMSENTINEL_LOG_LEVEL=INFO

# Frontend (frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api
